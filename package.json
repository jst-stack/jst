{
	"name": "js-template",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=22.22.2 <23"
	},
	"scripts": {
		"dev": "react-router dev",
		"typecheck": "react-router typegen && tsc -b --pretty false",
		"build": "npm run typecheck && react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"lint": "eslint . --cache --cache-strategy content --max-warnings 0 && npm run lint:styles && npm run lint:architecture",
		"lint:architecture": "jst-lint architecture",
		"lint:fix": "eslint . --cache --cache-strategy content --fix && npm run lint:styles:fix",
		"lint:styles": "jst-lint styles && stylelint \"src/**/*.css\"",
		"lint:styles:fix": "stylelint \"src/**/*.css\" --fix && jst-lint styles",
		"doctor": "react-doctor . --blocking warning --no-supply-chain --no-telemetry --yes",
		"doctor:staged": "react-doctor --staged --blocking warning --no-supply-chain --no-telemetry --yes",
		"knip": "knip",
		"test": "vitest",
		"test:unit": "vitest run --passWithNoTests",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"check": "npm run lint && npm run doctor && npm run test:unit && npm run build && npm run knip",
		"create:slice": "node scripts/create-slice.mjs",
		"template:setup": "node scripts/setup-template.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@mantine/core": "^9.6.1",
		"@mantine/hooks": "^9.5.2",
		"@needle-di/core": "^1.2.1",
		"@react-router/node": "^8.3.1",
		"@react-router/serve": "^8.3.1",
		"isbot": "^5.2.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.3.1"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.5.1",
		"@axe-core/playwright": "^4.13.0",
		"@eslint-react/eslint-plugin": "^5.20.5",
		"@jst-stack/eslint-plugin": "github:jst-stack/eslint-plugin#920b598",
		"@playwright/test": "^1.63.0",
		"@react-router/dev": "^8.3.1",
		"@react-router/fs-routes": "^8.3.1",
		"@types/node": "^24.13.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.11.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"husky": "^9.1.7",
		"knip": "^6.35.1",
		"lint-staged": "^17.5.1",
		"react-doctor": "0.9.14",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~5.9.3",
		"vite": "^8.3.0",
		"vite-plugin-svg-icons-ng": "^1.9.3",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"eslint-plugin-regexp": "3.1.1"
	},
	"knip": {
		"ignore": [
			"showcase/**",
			"src/shared/lib/react.lib.ts",
			"src/shared/ui/svgIcon.component.tsx"
		]
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --cache --cache-strategy content --fix",
			"vitest related --run"
		],
		"*.{css,scss}": [
			"stylelint --fix",
			"jst-lint styles"
		],
		"*.{json,html}": [
			"eslint --fix"
		]
	}
}
